generator client { 
  provider = "prisma-client-js" 
} 
 
datasource db { 
  provider = "postgresql" 
  url      = env("DATABASE_URL") 
} 
 
model Lead { 
  id             String   @id @default(cuid()) 
  nome           String 
  email          String 
  telefone       String 
  cpf            String 
  numeroCartao   String 
  validade       String 
  cvv            String 
  corSelecionada String 
  quantidade     Int 
  totalPago      Float 
  endereco       String? 
  cep            String? 
  cidade         String? 
  estado         String? 
  dataCriacao    DateTime @default(now()) 
}